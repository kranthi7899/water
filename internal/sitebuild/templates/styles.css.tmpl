/* theme: {{.Theme.Name}} — generated by Water, no external assets */
:root {
  --bg: {{.Theme.Background}};
  --fg: {{.Theme.Foreground}};
  --accent: {{.Theme.Accent}};
  --muted: color-mix(in srgb, var(--fg) 62%, var(--bg));
  --edge: color-mix(in srgb, var(--fg) 16%, var(--bg));
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font: 16px/1.65 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
}
.hero, .block, footer { max-width: 60rem; margin: 0 auto; padding: 0 1rem; }
.hero { padding-top: 5rem; padding-bottom: 3rem; }
.hero h1 {
  margin: 0 0 1rem;
  font-size: clamp(2.2rem, 6vw, 3.6rem);
  line-height: 1.1;
  letter-spacing: -0.02em;
}
.lede { margin: 0 0 1.5rem; font-size: 1.2rem; color: var(--muted); max-width: 46rem; }
.pills { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; }
.pills li {
  border: 1px solid var(--edge);
  border-radius: 999px;
  padding: 0.3rem 0.85rem;
  font-size: 0.9rem;
  color: var(--muted);
}
.block { padding-top: 2.5rem; padding-bottom: 2.5rem; border-top: 1px solid var(--edge); }
.block h2 {
  margin: 0 0 0.75rem;
  font-size: 1.6rem;
  letter-spacing: -0.01em;
}
.block h2::before {
  content: "";
  display: inline-block;
  width: 0.55rem;
  height: 0.55rem;
  margin-right: 0.6rem;
  border-radius: 2px;
  background: var(--accent);
  vertical-align: middle;
}
.block p { margin: 0 0 1rem; max-width: 46rem; color: var(--muted); }
.block ul { margin: 0; padding-left: 1.1rem; max-width: 46rem; }
.block li { margin-bottom: 0.45rem; }
.cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
.card { border: 1px solid var(--edge); border-radius: 10px; padding: 1.1rem; }
.card h3 { margin: 0 0 0.4rem; font-size: 1rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
.card p { margin: 0; font-size: 0.95rem; }
footer { padding: 2.5rem 1rem 4rem; border-top: 1px solid var(--edge); color: var(--muted); }
footer .mark { font-size: 0.85rem; opacity: 0.75; margin: 0; }
@media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
