<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="{{.Description}}">
<link rel="stylesheet" href="styles.css">
</head>
<body>
<header class="hero" id="{{.Hero.ID}}">
<h1>{{.Hero.Heading}}</h1>
{{if .Hero.Body}}<p class="lede">{{.Hero.Body}}</p>{{end}}
{{if .Hero.Bullets}}<ul class="pills">
{{range .Hero.Bullets}}<li>{{.}}</li>
{{end}}</ul>{{end}}
</header>
<main>
{{range .Blocks}}<section class="block" id="{{.ID}}">
<h2>{{.Heading}}</h2>
{{if .Body}}<p>{{.Body}}</p>{{end}}
{{if .Roles}}<div class="cards">
{{range .Roles}}<article class="card">
<h3>{{.Name}}</h3>
<p>{{.Blurb}}</p>
</article>
{{end}}</div>{{else if .Bullets}}<ul>
{{range .Bullets}}<li>{{.}}</li>
{{end}}</ul>{{end}}
</section>
{{end}}</main>
<footer id="{{.Footer.ID}}">
{{if .Footer.Body}}<p>{{.Footer.Body}}</p>{{end}}
<p class="mark">Generated by Water</p>
</footer>
</body>
</html>
